{
  "name": "dots-assistant-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "db:migrate": "node dist/migrate.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@mastra/core": "1.66.0",
    "bullmq": "^5.76.10",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.22.3",
    "typescript": "^5.9.2"
  }
}
